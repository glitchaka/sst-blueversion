{
  "schema": 2,
  "repository": {
    "name": "sst-main",
    "description": "SST native PKGX modules and explicitly managed environments; no third-party executable packages"
  },
  "packages": [
    {
      "id": "powershell",
      "name": "Motor PowerShell SDK para SST",
      "version": "latest",
      "description": "Motor PowerShell 7 en el proceso SST; cmdlets, objetos, tuberías y archivos .ps1 mediante runspace .NET embebido",
      "category": "module",
      "portability": "isolated",
      "source": {
        "type": "github_release",
        "repository": "glitchaka/sst-blueversion",
        "asset_contains": [
          "SST-PowerShell-win-x64.pkgx"
        ],
        "asset_excludes": []
      },
      "install": {
        "type": "pkgx",
        "expose": []
      },
      "format": 1,
      "execution": {
        "kind": "embedded",
        "entry": "Sst.PowerShell.Bridge.dll",
        "commands": [
          "psmodule",
          "psh",
          "powershell"
        ],
        "extensions": [
          ".ps1"
        ],
        "abi": "sst-hostfxr/1",
        "startup": "load",
        "required_files": [
          "Sst.PowerShell.Bridge.runtimeconfig.json",
          "hostfxr.dll"
        ],
        "target": "win"
      }
    },
    {
      "id": "arch",
      "name": "Arch Linux (WSL2)",
      "version": "rolling",
      "description": "Entorno oficial Arch Linux para Windows Subsystem for Linux 2; requiere habilitación explícita de WSL",
      "category": "environment",
      "portability": "system",
      "format": 1,
      "source": {
        "type": "system"
      },
      "install": {
        "type": "system",
        "expose": []
      },
      "execution": {
        "kind": "environment",
        "entry": "wsl.exe",
        "commands": [
          "arch"
        ],
        "extensions": [],
        "provider": "wsl",
        "distribution": "archlinux",
        "startup": "discover",
        "required_files": [],
        "target": "unix"
      }
    }
  ]
}
