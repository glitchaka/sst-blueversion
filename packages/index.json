{
  "schema": 2,
  "repository": {
    "name": "sst-main",
    "description": "Catálogo de módulos SST adaptados y empaquetados en PKGX; sin programas, distribuciones ni ejecutables externos"
  },
  "packages": [
    {
      "id": "powershell",
      "name": "Motor PowerShell SDK para SST",
      "version": "latest",
      "description": "Motor PowerShell 7 en el proceso SST; cmdlets, objetos, tuberías y archivos .ps1 mediante runspace .NET embebido",
      "category": "module",
      "portability": "isolated",
      "source": {
        "type": "github_release",
        "repository": "glitchaka/sst-blueversion",
        "release_tag": "powershell-v7.5.13",
        "asset_contains": [
          "SST-PowerShell-win-x64.pkgx"
        ],
        "asset_excludes": []
      },
      "install": {
        "type": "pkgx",
        "expose": []
      },
      "format": 1,
      "execution": {
        "kind": "embedded",
        "entry": "Sst.PowerShell.Bridge.dll",
        "commands": [
          "psmodule",
          "psh",
          "powershell"
        ],
        "extensions": [
          ".ps1"
        ],
        "abi": "sst-hostfxr/1",
        "startup": "load",
        "required_files": [
          "Sst.PowerShell.Bridge.runtimeconfig.json",
          "hostfxr.dll"
        ],
        "target": "win"
      }
    }
  ]
}
