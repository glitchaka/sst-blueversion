export component ActivityScale inherits Rectangle {
    in property <float> ratio;
    in property <color> ink;
    in property <color> track;
    background: transparent;
    for i in 16 : Rectangle {
        x: i * parent.width / 16; width: max(1px,parent.width / 16 - 1px);
        height: parent.height; background: root.ratio * 16 >= i + 1 ? root.ink : root.track;
    }
}
export component SegmentedProgress inherits Rectangle {
    in property <float> ratio;
    in property <color> ink;
    in property <color> track;
    background: transparent;
    for i in 12 : Path {
        x: i * parent.width / 12; width: max(1px,parent.width / 12 - 2px); height: parent.height;
        viewbox-width: 100; viewbox-height: 100; fit: fill;
        commands: "M 0 0 L 100 0 L 100 70 L 80 100 L 0 100 Z";
        fill: root.ratio * 12 >= i + 1 ? root.ink : root.track; stroke: transparent;
    }
}
export component IndeterminateWait inherits Rectangle {
    in property <int> phase;
    in property <color> ink;
    in property <color> track;
    in property <color> line;
    background: root.track;
    for i in 12 : Path {
        x: i * parent.width / 12; width: max(1px,parent.width / 12 - 2px); height: parent.height;
        viewbox-width: 100; viewbox-height: 100; fit: fill;
        commands: "M 0 20 L 100 0 L 100 80 L 0 100 Z";
        fill: root.phase == i ? root.ink : root.line; stroke: transparent;
    }
}
export component HatchedTransfer inherits Rectangle {
    in property <float> ratio;
    in property <color> ink;
    in property <color> track;
    in property <color> line;
    background: transparent;
    CutFrame { width: parent.width; height: parent.height; ink: root.track; outline: root.line; thickness: 1px; }
    for i in 18 : Path {
        x: i * parent.width / 18; y: 2px; width: max(1px,parent.width / 18 - 2px); height: max(1px,parent.height - 4px);
        viewbox-width: 100; viewbox-height: 100; fit: fill;
        commands: "M 0 100 L 55 0 L 100 0 L 45 100 Z";
        fill: root.ratio * 18 >= i + 1 ? root.ink : root.line; stroke: transparent;
    }
}

export component MonitorFrame inherits Rectangle {
    in property <color> ink;
    in property <color> line;
    background: transparent;
    // Fixed-width corner geometry. Never stretch a diagonal over the text.
    Rectangle { x: 9px; y: 0px; width: max(1px,parent.width - 18px); height: 1px; background: root.line; }
    Rectangle { x: 9px; y: parent.height - 1px; width: max(1px,parent.width - 18px); height: 1px; background: root.line; }
    Rectangle { x: 0px; y: 7px; width: 1px; height: max(1px,parent.height - 14px); background: root.line; }
    Rectangle { x: parent.width - 1px; y: 7px; width: 1px; height: max(1px,parent.height - 14px); background: root.line; }
    Path { x: 0px; y: 0px; width: 18px; height: 14px; viewbox-width: 18; viewbox-height: 14; fit: fill;
        commands: "M 0 14 L 0 7 L 9 0 L 18 0"; fill: transparent; stroke: root.ink; stroke-width: 1.5px; }
    Path { x: parent.width - 18px; y: 0px; width: 18px; height: 14px; viewbox-width: 18; viewbox-height: 14; fit: fill;
        commands: "M 0 0 L 9 0 L 18 7 L 18 14"; fill: transparent; stroke: root.ink; stroke-width: 1.5px; }
    Path { x: 0px; y: parent.height - 14px; width: 18px; height: 14px; viewbox-width: 18; viewbox-height: 14; fit: fill;
        commands: "M 0 0 L 0 7 L 9 14 L 18 14"; fill: transparent; stroke: root.ink; stroke-width: 1.5px; }
    Path { x: parent.width - 18px; y: parent.height - 14px; width: 18px; height: 14px; viewbox-width: 18; viewbox-height: 14; fit: fill;
        commands: "M 0 14 L 9 14 L 18 7 L 18 0"; fill: transparent; stroke: root.ink; stroke-width: 1.5px; }
}

export component WarningTriangle inherits Rectangle {
    in property <color> ink;
    background: transparent;
    Path { width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100; fit: fill;
        commands: "M 50 0 L 100 100 L 0 100 Z"; fill: transparent; stroke: root.ink; stroke-width: 1.5px;
    }
}
export component StateBadge inherits Rectangle {
    in property <color> ink: transparent;
    in property <color> outline: transparent;
    background: transparent;
    CutFrame { width: parent.width; height: parent.height; ink: root.ink; outline: root.outline; thickness: 1px; }
}
