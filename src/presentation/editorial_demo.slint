                Rectangle { x: 0px; y: 21px; width: parent.width; height: 1px; background: root.selected == 0 ? root.acid : root.line; }
                Rectangle { x: 2px; y: 27px; width: parent.width - 4px; height: max(1px, min(82px, parent.height - 29px)); background: transparent; clip: true;
AsymmetricHeader { x: 0px; y: 8px; width: parent.width; height: 32px; ink: root.cream; }Text { x: 10px; y: 8px; width: parent.width - 65px; height: 32px; text: "SECCIÓN / 01"; color: root.ink; font-family: "Cascadia Mono"; font-size: 15px; font-weight: 800; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }SignalSlashes { x: parent.width - 44px; y: 10px; width: 34px; height: 14px; ink: root.accent-detail; }
                }
            }
