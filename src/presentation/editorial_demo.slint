                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 78 30 C 82 30 83 50 87.5 50 M 78 70 C 82 70 83 50 87.5 50"; fill: transparent; stroke: root.steel; stroke-width: 1px; }
                for i in 4 : Rectangle { x: parent.width * (0.125 + i * 0.25) - 7px; y: parent.height * 0.5 - 7px; width: 14px; height: 14px;
                    border-radius: 7px; background: i == 2 ? root.amber : i == 3 ? root.steel : root.acid; border-width: 2px; border-color: root.graphite; }
