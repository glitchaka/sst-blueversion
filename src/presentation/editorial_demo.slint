// Native editorial specimens. No Image, SVG assets, screenshots or terminal skins.
// The graphics carry information: alignment, magnitude, state, sequence, focus.
component Head inherits Text {
    font-family: "Segoe UI Variable Display";
    font-weight: 800;
    vertical-alignment: center;
    overflow: elide;
}
component Label inherits Text {
    font-family: "Segoe UI Variable";
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}
component Data inherits Text {
    font-family: "Cascadia Mono";
    vertical-alignment: center;
    overflow: elide;
}
export component EditorialDemo inherits Rectangle {
    in property <int> page;
    in property <int> count;
    in property <string> title;
    in property <int> selected;
    in property <int> progress;
    in property <int> cpu;
    in property <int> phase;
    in property <bool> blink;
    in property <bool> paused;
    in property <bool> action;

    property <color> paper: #eee9db;
    property <color> ink: #222421;
    property <color> muted: #666b64;
    property <color> rule: #a5a59a;
    property <color> white-ink: #e9e5d7;
    property <color> graphite: #202522;
    property <color> oxide: #a83929;
    property <color> alert: #a82e24;
    property <color> amber: #e5a050;
    property <color> mint: #a7bda6;
    property <color> moss: #386657;
    property <length> pad: min(32px, max(10px, self.width * 0.035));
    property <length> small: min(14px, max(10px,self.height * 0.033));
    property <length> normal: min(19px, max(12px,self.height * 0.045));
    background: root.paper;
    clip: true;

    Rectangle { x: 0; y: 0; width: parent.width; height: 30px; background: root.paper;
        Rectangle { x: root.pad; y: 29px; width: parent.width - 2 * root.pad; height: 1px; background: root.ink; }
        Data { x: root.pad; width: parent.width * 0.69; height: parent.height; text: "SST / " + root.title; color: root.ink; font-size: root.small; }
        Data { x: parent.width * 0.70; width: parent.width * 0.30 - root.pad; height: parent.height; horizontal-alignment: right;
            text: "SIMULACIÓN   " + root.page + " / " + root.count; color: root.muted; font-size: root.small; }
    }
    plate := Rectangle {
        x: root.pad; y: 36px; width: root.width - 2 * root.pad; height: max(1px,root.height - 87px);
        background: root.paper; clip: true;
        property <length> w: self.width;
        property <length> h: self.height;

        // 01 — a typographic cover with asymmetric columns; the datum is the image.
        if root.page == 1 : Rectangle {
            Rectangle { x: 0; y: plate.h * 0.03; width: plate.w * 0.12; height: 5px; background: root.oxide; }
            Data { x: 0; y: plate.h * 0.07; width: plate.w; height: plate.h * 0.09; text: "01 / INVENTARIO LOCAL"; color: root.muted; font-size: root.small; }
            Head { x: 0; y: plate.h * 0.15; width: plate.w * 0.71; height: plate.h * 0.29; text: "ESTADO"; color: root.ink;
                font-size: min(plate.w * 0.136,plate.h * 0.30); }
            Head { x: 0; y: plate.h * 0.44; width: plate.w * 0.71; height: plate.h * 0.22; text: "DEL EQUIPO"; color: root.ink;
                font-size: min(plate.w * 0.078,plate.h * 0.22); }
            Rectangle { x: plate.w * 0.74; y: plate.h * 0.12; width: 1px; height: plate.h * 0.79; background: root.ink; }
            Head { x: plate.w * 0.77; y: plate.h * 0.13; width: plate.w * 0.23; height: plate.h * 0.44; text: "08"; color: root.oxide;
                font-size: min(plate.w * 0.17,plate.h * 0.45); }
            Data { x: plate.w * 0.77; y: plate.h * 0.56; width: plate.w * 0.23; height: plate.h * 0.12; text: "RECURSOS"; color: root.ink; font-size: root.small; }
            Rectangle { x: 0; y: plate.h * 0.74; width: plate.w * 0.69; height: 1px; background: root.ink; }
            Data { x: 0; y: plate.h * 0.78; width: plate.w * 0.72; height: plate.h * 0.16; text: "Windows 11   /   16 GiB   /   x86-64"; color: root.muted; font-size: root.small; }
        }
        // 02 — index-led network section, not a card.
        if root.page == 2 : Rectangle {
            Rectangle { width: plate.w * 0.25; height: plate.h; background: root.ink;
                Head { x: 8px; y: 0; width: parent.width - 16px; height: parent.height * 0.65; text: "02"; color: root.paper;
                    font-size: min(parent.width * 0.75,parent.height * 0.47); }
                Data { x: 8px; y: parent.height * 0.75; width: parent.width - 16px; height: parent.height * 0.14; text: "INTERFACES"; color: root.paper; font-size: root.small; }
            }
            Head { x: plate.w * 0.29; y: 0; width: plate.w * 0.71; height: plate.h * 0.31; text: "RED LOCAL"; color: root.ink; font-size: min(plate.w * 0.092,plate.h * 0.28); }
            for item[i] in ["Ethernet","Wi-Fi"] : Rectangle {
                x: plate.w * 0.29; y: plate.h * (0.39 + i * 0.24); width: plate.w * 0.71; height: plate.h * 0.24;
                Rectangle { y: 0; width: parent.width; height: i == 0 ? 3px : 1px; background: root.ink; }
                Label { x: 0; width: parent.width * 0.6; height: parent.height; text: item; font-size: root.normal; color: root.ink; }
                Data { x: parent.width * 0.6; width: parent.width * 0.4; height: parent.height; horizontal-alignment: right;
                    text: i == 0 ? "ACTIVO" : "INACTIVO"; color: i == 0 ? root.moss : root.muted; font-size: root.small; }
            }
            Data { x: plate.w * 0.29; y: plate.h * 0.90; width: plate.w * 0.71; height: plate.h * 0.10; text: "1 enlace en uso / 1 desconectado"; font-size: root.small; color: root.muted; }
        }
        // 03 — memory as an area-proportional horizontal cut.
        if root.page == 3 : Rectangle {
            background: root.graphite;
            Data { x: 12px; y: 0; width: plate.w - 24px; height: plate.h * 0.15; text: "MEMORIA FÍSICA / 16 GiB"; color: root.mint; font-size: root.small; }
            Rectangle { x: 12px; y: plate.h * 0.19; width: plate.w - 24px; height: plate.h * 0.58; background: #7f8c83;
                Rectangle { width: parent.width * 0.65; height: parent.height; background: root.paper;
                    Head { x: 8px; width: parent.width - 16px; height: parent.height * 0.75; text: "65%"; color: root.ink; font-size: min(parent.width * 0.43,parent.height * 0.70); }
                    Data { x: 12px; y: parent.height * 0.78; width: parent.width - 24px; height: parent.height * 0.20; text: "10.4 GiB usados"; font-size: root.small; color: root.ink; }
                }
                Data { x: parent.width * 0.68; width: parent.width * 0.30; height: parent.height; text: "5.6 GiB libres"; color: root.ink; font-size: root.small; }
            }
            Data { x: 12px; y: plate.h * 0.82; width: plate.w - 24px; height: plate.h * 0.14; text: "Capacidad y proporción, no velocidad de memoria."; color: root.white-ink; font-size: root.small; }
        }
        // 04 — native aligned service register with sparse rules.
        if root.page == 4 : Rectangle {
            Head { x: 0; y: 0; width: plate.w * 0.76; height: plate.h * 0.30; text: "Servicios"; color: root.ink; font-size: min(plate.w * 0.13,plate.h * 0.30); }
            Data { x: plate.w * 0.76; width: plate.w * 0.24; height: plate.h * 0.30; horizontal-alignment: right; text: "03 / REGISTROS"; font-size: root.small; color: root.muted; }
            for name[i] in ["Servicio","W32Time","Spooler","BITS"] : Rectangle {
                y: plate.h * (0.34 + i * 0.16); width: plate.w; height: plate.h * 0.16; background: i == 0 ? root.ink : transparent;
                Rectangle { y: 0; width: parent.width; height: 1px; background: root.rule; }
                Data { x: 8px; width: parent.width * 0.46; height: parent.height; text: name; font-size: root.normal; color: i == 0 ? root.paper : root.ink; }
                Data { x: parent.width * 0.49; width: parent.width * 0.30; height: parent.height; text: ["Estado","Activo","Activo","Detenido"][i]; font-size: root.normal; color: i == 0 ? root.paper : i == 3 ? root.muted : root.moss; }
                Data { x: parent.width * 0.83; width: parent.width * 0.15; height: parent.height; horizontal-alignment: right; text: ["PID","804","1220","—"][i]; color: i == 0 ? root.paper : root.ink; font-size: root.small; }
            }
        }
        // 05 — keyboard focus, distinct from activation.
        if root.page == 5 : Rectangle {
            background: root.graphite;
            Head { x: 12px; y: 0; width: plate.w - 24px; height: plate.h * 0.22; text: "Diagnóstico dirigido"; color: root.paper; font-size: min(plate.w * 0.070,plate.h * 0.22); }
            for item[i] in ["Procesos","Servicios","Conexiones"] : Rectangle {
                x: 12px; y: plate.h * (0.27 + i * 0.19); width: plate.w * 0.58 - 16px; height: plate.h * 0.17;
                background: i == root.selected ? root.paper : transparent;
                Rectangle { x: 0; width: 4px; height: parent.height; background: i == root.selected ? root.amber : #515c54; }
                Data { x: 12px; width: parent.width - 24px; height: parent.height; text: "0" + (i+1) + "  " + item; font-size: root.normal; color: i == root.selected ? root.ink : root.paper; }
            }
            Rectangle { x: plate.w * 0.60; y: plate.h * 0.28; width: 1px; height: plate.h * 0.52; background: root.mint; }
            Head { x: plate.w * 0.63; y: plate.h * 0.29; width: plate.w * 0.34; height: plate.h * 0.21; text: "0" + (root.selected+1); font-size: min(plate.w * 0.12,plate.h * 0.22); color: root.amber; }
            Label { x: plate.w * 0.63; y: plate.h * 0.54; width: plate.w * 0.34; height: plate.h * 0.14; text: root.action ? "Activado (demo)" : "Solo foco"; color: root.paper; font-size: root.normal; }
            Data { x: 12px; y: plate.h * 0.88; width: plate.w - 24px; height: plate.h * 0.10; text: "Tab / ↑ ↓: foco     Enter: activar o volver"; font-size: root.small; color: root.mint; }
        }
        // 06 — threshold delta and a scale with the reference line.
        if root.page == 6 : Rectangle {
            background: #e8c8a3;
            Data { x: 12px; y: 0; width: plate.w - 24px; height: plate.h * 0.15; text: "ATENCIÓN / PRESIÓN DE MEMORIA"; color: root.ink; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.14; width: plate.w * 0.56; height: plate.h * 0.43; text: "89%"; color: root.ink; font-size: min(plate.w * 0.21,plate.h * 0.43); }
            Head { x: plate.w * 0.63; y: plate.h * 0.18; width: plate.w * 0.34; height: plate.h * 0.30; text: "+4"; color: root.oxide; font-size: min(plate.w * 0.13,plate.h * 0.29); }
            Data { x: plate.w * 0.63; y: plate.h * 0.48; width: plate.w * 0.34; height: plate.h * 0.09; text: "puntos sobre umbral"; color: root.ink; font-size: root.small; }
            Rectangle { x: 12px; y: plate.h * 0.65; width: plate.w - 24px; height: plate.h * 0.10; background: #b7a38e;
                Rectangle { width: parent.width * 0.89; height: parent.height; background: root.ink; }
                Rectangle { x: parent.width * 0.85; y: -5px; width: 3px; height: parent.height + 10px; background: root.oxide; }
            }
            Data { x: 12px; y: plate.h * 0.80; width: plate.w * 0.6; height: plate.h * 0.14; text: "ACCIÓN: revisar procesos"; color: root.ink; font-size: root.small; }
            Data { x: plate.w * 0.63; y: plate.h * 0.80; width: plate.w * 0.34; height: plate.h * 0.14; text: "UMBRAL 85%"; horizontal-alignment: right; color: root.oxide; font-size: root.small; }
        }
        // 07 — recovery bulletin, explicit evidence and next action.
        if root.page == 7 : Rectangle {
            background: root.oxide;
            Data { x: 12px; width: plate.w - 24px; height: plate.h * 0.13; text: "INCIDENCIA 01 / VENTANA"; color: root.paper; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.13; width: plate.w - 24px; height: plate.h * 0.32; text: "SIN RESPUESTA"; color: root.paper; font-size: min(plate.w * 0.104,plate.h * 0.30); }
            Label { x: 12px; y: plate.h * 0.48; width: plate.w - 24px; height: plate.h * 0.13; text: "Evidencia: la ventana no responde a la consulta."; color: root.paper; font-size: root.normal; }
            Rectangle { y: plate.h * 0.67; width: plate.w; height: plate.h * 0.33; background: root.ink;
                Data { x: 12px; y: 0; width: parent.width - 24px; height: parent.height * 0.48; text: "01  Solicitar cierre normal"; font-size: root.normal; color: root.paper; }
                Data { x: 12px; y: parent.height * 0.48; width: parent.width - 24px; height: parent.height * 0.48; text: "02  Verificar instancia"; font-size: root.small; color: root.mint; }
            }
        }
        // 08 — twenty calibrated divisions; dynamic reading.
        if root.page == 8 : Rectangle {
            Data { x: 0; width: plate.w; height: plate.h * 0.13; text: "CPU / MUESTRA EN MOVIMIENTO"; color: root.muted; font-size: root.small; }
            Head { x: 0; y: plate.h * 0.12; width: plate.w * 0.64; height: plate.h * 0.45; text: root.cpu + "%"; color: root.ink; font-size: min(plate.w * 0.24,plate.h * 0.43); }
            Data { x: plate.w * 0.68; y: plate.h * 0.40; width: plate.w * 0.32; height: plate.h * 0.15; text: "20 DIVISIONES"; color: root.muted; font-size: root.small; }
            Rectangle { y: plate.h * 0.61; width: plate.w; height: plate.h * 0.23;
                for mark[i] in 20 : Rectangle { x: i * parent.width / 20; width: max(1px,parent.width / 20 - 3px); height: parent.height;
                    background: (i+1)*5 <= root.cpu ? (root.cpu >= 85 ? root.oxide : root.ink) : transparent; border-width: 1px; border-color: root.rule; }
            }
            Data { x: 0; y: plate.h * 0.86; width: plate.w * 0.5; height: plate.h * 0.13; text: "0   /   5% por segmento"; font-size: root.small; color: root.muted; }
            Data { x: plate.w * 0.70; y: plate.h * 0.86; width: plate.w * 0.30; height: plate.h * 0.13; text: "100%"; horizontal-alignment: right; font-size: root.small; color: root.ink; }
        }
        // 09 — native input treatment with three working caret positions.
        if root.page == 9 : Rectangle {
            background: root.graphite;
            Head { x: 12px; width: plate.w - 24px; height: plate.h * 0.25; text: "Entrada de comando"; color: root.paper; font-size: min(plate.w * 0.077,plate.h * 0.24); }
            Data { x: 12px; y: plate.h * 0.31; width: plate.w - 24px; height: plate.h * 0.12; text: "SST / LOCAL / USUARIO"; color: root.mint; font-size: root.small; }
            Rectangle { x: 12px; y: plate.h * 0.47; width: plate.w - 24px; height: plate.h * 0.22; background: #343c36;
                Data { x: 8px; width: parent.width * 0.11; height: parent.height; text: ">"; color: root.amber; font-size: root.normal; }
                for token[i] in ["sys","services","--running"] : Rectangle {
                    x: parent.width * (0.11 + i * 0.29); width: parent.width * 0.28; height: parent.height;
                    background: root.selected == i ? #4b554d : transparent;
                    Data { x: 6px; width: parent.width - 12px; height: parent.height; text: token; color: root.paper; font-size: root.normal; }
                    Rectangle { visible: root.selected == i && root.blink; x: parent.width - 3px; y: parent.height * 0.19; width: 2px; height: parent.height * 0.62; background: root.amber; }
                }
            }
            Data { x: 12px; y: plate.h * 0.78; width: plate.w - 24px; height: plate.h * 0.15; text: root.paused ? "Cursor fijo / Espacio reanuda" : "Tab cambia el foco / cursor intermitente"; color: root.mint; font-size: root.small; }
        }
        // 10 — determinate transfer; reaches a stable completed state.
        if root.page == 10 : Rectangle {
            Head { x: 0; width: plate.w * 0.72; height: plate.h * 0.24; text: "Transferencia"; color: root.ink; font-size: min(plate.w * 0.085,plate.h * 0.23); }
            Data { x: plate.w * 0.73; width: plate.w * 0.27; height: plate.h * 0.24; text: "PKGX / 100 MiB"; horizontal-alignment: right; color: root.muted; font-size: root.small; }
            Head { x: 0; y: plate.h * 0.25; width: plate.w * 0.66; height: plate.h * 0.32; text: root.progress + "%"; color: root.ink; font-size: min(plate.w * 0.19,plate.h * 0.31); }
            Data { x: plate.w * 0.68; y: plate.h * 0.39; width: plate.w * 0.32; height: plate.h * 0.16; text: root.progress == 100 ? "COMPLETO" : root.paused ? "EN PAUSA" : "RECIBIENDO"; color: root.moss; font-size: root.small; }
            Rectangle { y: plate.h * 0.62; width: plate.w; height: plate.h * 0.11; background: #c2c4b7;
                Rectangle { width: parent.width * root.progress / 100; height: parent.height; background: root.progress == 100 ? root.moss : root.ink; }
            }
            Data { x: 0; y: plate.h * 0.78; width: plate.w * 0.65; height: plate.h * 0.17; text: root.progress + " / 100 MiB   ·   datos ficticios"; color: root.ink; font-size: root.small; }
            Data { x: plate.w * 0.65; y: plate.h * 0.78; width: plate.w * 0.35; height: plate.h * 0.17; text: "Espacio / R"; horizontal-alignment: right; color: root.muted; font-size: root.small; }
        }
        // 11 — the row itself changes state when synthetic load crosses 85%.
        if root.page == 11 : Rectangle {
            background: root.graphite;
            Head { x: 8px; width: plate.w * 0.7; height: plate.h * 0.20; text: "Procesos activos"; color: root.paper; font-size: min(plate.w * 0.075,plate.h * 0.20); }
            Data { x: plate.w * 0.70; width: plate.w * 0.28; height: plate.h * 0.20; text: "CPU / UMBRAL 85%"; horizontal-alignment: right; color: root.mint; font-size: root.small; }
            for name[i] in ["olk.exe","explorer.exe","Teams.exe","sst.exe","System"] : Rectangle {
                x: 8px; y: plate.h * (0.24 + i * 0.14); width: plate.w - 16px; height: plate.h * 0.13;
                property <int> load: i == 0 ? root.cpu : [0,9,12,3,2][i];
                background: self.load >= 85 ? root.alert : root.selected == i ? #414d43 : transparent;
                Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: root.selected == i ? root.amber : transparent; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #576158; }
                Data { x: 8px; width: parent.width * 0.42; height: parent.height; text: name; font-size: root.small; color: root.paper; }
                Rectangle { x: parent.width * 0.46; y: parent.height * 0.28; width: parent.width * 0.30; height: parent.height * 0.44; background: #626e65;
                    property <int> bar-load: parent.load;
                    Rectangle { width: parent.width * parent.bar-load / 100; height: parent.height; background: root.paper; } }
                Data { x: parent.width * 0.79; width: parent.width * 0.19; height: parent.height; horizontal-alignment: right; text: parent.load + "%"; color: root.paper; font-size: root.normal; }
            }
        }
        // 12 — network continuity; individual sample slots and loss count.
        if root.page == 12 : Rectangle {
            Head { x: 0; width: plate.w * 0.8; height: plate.h * 0.25; text: "Continuidad"; color: root.ink; font-size: min(plate.w * 0.095,plate.h * 0.24); }
            Data { x: 0; y: plate.h * 0.27; width: plate.w; height: plate.h * 0.12; text: "ICMP / 12 muestras / 2 pérdidas simuladas"; color: root.muted; font-size: root.small; }
            Rectangle { y: plate.h * 0.43; width: plate.w; height: plate.h * 0.31;
                for i in 12 : Rectangle { x: i * parent.width / 12; width: parent.width / 12 - 4px; height: parent.height;
                    background: i == 3 || i == 9 ? root.oxide : root.moss;
                    border-width: i == root.phase ? 3px : 0px; border-color: root.ink;
                    Data { width: parent.width; height: parent.height; horizontal-alignment: center; text: i == 3 || i == 9 ? "×" : "·"; color: root.paper; font-size: root.normal; }
                }
            }
            Data { x: 0; y: plate.h * 0.80; width: plate.w * 0.65; height: plate.h * 0.16; text: "10 respuestas / 2 sin respuesta"; color: root.ink; font-size: root.small; }
            Data { x: plate.w * 0.68; y: plate.h * 0.80; width: plate.w * 0.32; height: plate.h * 0.16; text: "16.7% pérdida"; horizontal-alignment: right; color: root.oxide; font-size: root.normal; }
        }
        // 13 — semantically different severity signals, without tinting every line.
        if root.page == 13 : Rectangle {
            Head { x: 0; width: plate.w; height: plate.h * 0.20; text: "Estado de comprobación"; color: root.ink; font-size: min(plate.w * 0.071,plate.h * 0.19); }
            for item[i] in ["Correcto","Atención","Fallo","Sin evidencia"] : Rectangle {
                x: 0; y: plate.h * (0.23 + i * 0.18); width: plate.w; height: plate.h * 0.17;
                background: root.selected == i ? #dad8ca : transparent;
                Rectangle { x: 0; y: 0; width: 4px; height: parent.height; background: [root.moss,root.amber,root.alert,root.muted][i]; }
                Label { x: 12px; width: parent.width * 0.37; height: parent.height; text: item; font-size: root.normal; color: root.ink; }
                Data { x: parent.width * 0.40; width: parent.width * 0.58; height: parent.height; text: ["Enlace activo","RAM sobre umbral","DNS sin respuesta","Permiso insuficiente"][i]; color: root.muted; font-size: root.small; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: root.rule; }
            }
        }
        // 14 — high-density inventory. Narrow widths hide secondary columns only.
        if root.page == 14 : Rectangle {
            Data { x: 0; width: plate.w; height: plate.h * 0.12; text: "INVENTARIO / CONTROLADORES / " + (plate.w >= 570px ? "VISTA AMPLIA" : "VISTA COMPACTA"); color: root.muted; font-size: root.small; }
            for item[i] in ["Driver","Wdf01000","WlanSvc","W32Time","Wof","WUDFRd"] : Rectangle {
                y: plate.h * (0.15 + i * 0.14); width: plate.w; height: plate.h * 0.14;
                background: i == 0 ? root.ink : i == root.selected+1 ? #d8dacc : transparent;
                Data { x: 6px; width: parent.width * 0.38; height: parent.height; text: item; color: i == 0 ? root.paper : root.ink; font-size: root.small; }
                Data { x: parent.width * 0.40; width: parent.width * 0.32; height: parent.height; text: ["Tipo","Kernel","Servicio","Servicio","Sistema","Kernel"][i]; color: i == 0 ? root.paper : root.ink; font-size: root.small; }
                Data { visible: plate.w >= 570px; x: parent.width * 0.73; width: parent.width * 0.25; height: parent.height; text: ["Estado","Cargado","Activo","Activo","Cargado","Cargado"][i]; color: i == 0 ? root.paper : root.muted; font-size: root.small; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: root.rule; }
            }
        }
        // 15 — disclosure without changing the report's position.
        if root.page == 15 : Rectangle {
            Head { x: 0; width: plate.w; height: plate.h * 0.25; text: "Evidencia del proceso"; color: root.ink; font-size: min(plate.w * 0.075,plate.h * 0.24); }
            for item[i] in ["Identidad","Conexiones","Persistencia"] : Rectangle {
                x: 0; y: plate.h * (0.29 + i * 0.19); width: plate.w * 0.44; height: plate.h * 0.17;
                background: root.selected == i ? root.ink : transparent;
                Data { x: 8px; width: parent.width - 16px; height: parent.height; text: (root.selected == i && root.action ? "− " : "+ ") + item; color: root.selected == i ? root.paper : root.ink; font-size: root.small; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: root.rule; }
            }
            Rectangle { x: plate.w * 0.48; y: plate.h * 0.29; width: 1px; height: plate.h * 0.56; background: root.ink; }
            Label { x: plate.w * 0.51; y: plate.h * 0.29; width: plate.w * 0.49; height: plate.h * 0.19; text: root.action ? ["PID 4321 / olk.exe","TCP 443 / 2 destinos","Inicio: usuario"][root.selected] : "Detalle bajo demanda"; color: root.ink; font-size: root.normal; }
            Data { x: plate.w * 0.51; y: plate.h * 0.50; width: plate.w * 0.49; height: plate.h * 0.19; text: root.action ? ["Firma: válida (demo)","TLS: contenido no observado","Sin cambio en esta muestra"][root.selected] : "Enter para expandir"; color: root.muted; font-size: root.small; }
        }
        // 16 — safe confirmation: a real state transition, no host mutation.
        if root.page == 16 : Rectangle {
            background: root.graphite;
            Data { x: 12px; width: plate.w - 24px; height: plate.h * 0.14; text: "SIMULACIÓN / RECUPERACIÓN"; color: root.mint; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.14; width: plate.w - 24px; height: plate.h * 0.26; text: root.action ? "Decisión registrada" : "¿Cerrar la instancia?"; color: root.paper; font-size: min(plate.w * 0.076,plate.h * 0.25); }
            Label { x: 12px; y: plate.h * 0.43; width: plate.w - 24px; height: plate.h * 0.13; text: root.action ? ["Cancelado","Solo cierre normal simulado","Detalles consultados"][root.selected] : "PID 4321 · no se modifica el equipo"; color: root.paper; font-size: root.normal; }
            for item[i] in ["Cancelar","Cerrar","Detalles"] : Rectangle {
                x: 12px + i * (plate.w - 24px) / 3; y: plate.h * 0.67; width: (plate.w - 24px) / 3 - 4px; height: plate.h * 0.22;
                background: root.selected == i ? root.paper : transparent; border-width: 1px; border-color: root.paper;
                Label { x: 6px; width: parent.width - 12px; height: parent.height; horizontal-alignment: center; text: item; font-size: root.normal; color: root.selected == i ? root.ink : root.paper; }
            }
        }
        // 17 — a route, not decorative geometry; each segment has meaning.
        if root.page == 17 : Rectangle {
            Head { x: 0; width: plate.w; height: plate.h * 0.26; text: "Ruta de diagnóstico"; color: root.ink; font-size: min(plate.w * 0.087,plate.h * 0.25); }
            Rectangle { x: plate.w * 0.12; y: plate.h * 0.49; width: plate.w * 0.76; height: 2px; background: root.rule; }
            for item[i] in ["Equipo","Gateway","DNS","Destino"] : Rectangle {
                x: i * plate.w / 4; y: plate.h * 0.32; width: plate.w / 4; height: plate.h * 0.51; background: transparent;
                Rectangle { x: parent.width * 0.46; y: plate.h * 0.14; width: 14px; height: 14px; background: i == 2 ? root.oxide : i == 3 ? root.muted : root.moss; }
                Label { y: plate.h * 0.24; width: parent.width; height: plate.h * 0.12; text: item; horizontal-alignment: center; color: root.ink; font-size: root.normal; }
                Data { y: plate.h * 0.38; width: parent.width; height: plate.h * 0.10; text: ["OK","1 ms","FALLO","No probado"][i]; horizontal-alignment: center; color: i == 2 ? root.oxide : root.muted; font-size: root.small; }
            }
            Data { x: 0; y: plate.h * 0.86; width: plate.w; height: plate.h * 0.13; text: "Siguiente: comprobar resolución DNS antes de inferir caída del destino."; font-size: root.small; color: root.ink; }
        }
        // 18 — partial evidence: absence of telemetry is not a failure.
        if root.page == 18 : Rectangle {
            Rectangle { x: 0; y: 0; width: 5px; height: plate.h * 0.82; background: root.muted; }
            Data { x: 14px; width: plate.w - 14px; height: plate.h * 0.13; text: "COBERTURA PARCIAL / ETW"; color: root.muted; font-size: root.small; }
            Head { x: 14px; y: plate.h * 0.13; width: plate.w - 14px; height: plate.h * 0.32; text: "Dato no disponible"; color: root.ink; font-size: min(plate.w * 0.080,plate.h * 0.30); }
            Label { x: 14px; y: plate.h * 0.48; width: plate.w - 14px; height: plate.h * 0.14; text: "No se pudo iniciar la sesión de telemetría."; color: root.ink; font-size: root.normal; }
            Data { x: 14px; y: plate.h * 0.66; width: plate.w - 14px; height: plate.h * 0.11; text: "Disponible: conexiones y PID / No medido: bytes por proceso"; color: root.muted; font-size: root.small; }
            Data { x: 14px; y: plate.h * 0.86; width: plate.w - 14px; height: plate.h * 0.11; text: "No equivale a 0 B/s ni demuestra ausencia de tráfico."; color: root.ink; font-size: root.small; }
        }
        // 19 — indeterminate progress, not a fictitious percentage.
        if root.page == 19 : Rectangle {
            background: root.graphite;
            Data { x: 12px; width: plate.w - 24px; height: plate.h * 0.13; text: "OPERACIÓN / CONSULTA DE INVENTARIO"; color: root.mint; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.14; width: plate.w - 24px; height: plate.h * 0.33; text: root.action ? "Resultado recibido" : "Consultando"; color: root.paper; font-size: min(plate.w * 0.105,plate.h * 0.31); }
            Rectangle { x: 12px; y: plate.h * 0.59; width: plate.w - 24px; height: plate.h * 0.12; background: #46534a;
                Rectangle { x: root.action ? 0px : (parent.width * 0.75 * root.phase / 11); width: root.action ? parent.width : parent.width * 0.25; height: parent.height; background: root.action ? root.mint : root.amber; } }
            Data { x: 12px; y: plate.h * 0.80; width: plate.w - 24px; height: plate.h * 0.14; text: root.action ? "Completo / Enter reinicia la espera" : "Total desconocido / Enter simula respuesta"; color: root.paper; font-size: root.small; }
        }
        // 20 — suggestions anchored to a command, with live keyboard selection.
        if root.page == 20 : Rectangle {
            Head { x: 0; width: plate.w; height: plate.h * 0.22; text: "Sugerencias contextuales"; color: root.ink; font-size: min(plate.w * 0.070,plate.h * 0.21); }
            Rectangle { y: plate.h * 0.25; width: plate.w; height: plate.h * 0.17; background: root.ink;
                Data { x: 8px; width: parent.width - 16px; height: parent.height; text: root.action ? "> notsh wlan show " + ["interfaces","profiles","networks"][root.selected] : "> notsh wlan show"; color: root.paper; font-size: root.normal; }
            }
            for name[i] in ["interfaces","profiles","help"] : Rectangle {
                x: plate.w * 0.17; y: plate.h * (0.46 + i * 0.15); width: plate.w * 0.83; height: plate.h * 0.14; background: root.selected == i ? #d2d7c8 : transparent;
                Rectangle { x: 0; width: 3px; height: parent.height; background: root.selected == i ? root.moss : root.rule; }
                Data { x: 8px; width: parent.width * 0.37; height: parent.height; text: name; color: root.ink; font-size: root.normal; }
                Label { x: parent.width * 0.40; width: parent.width * 0.58; height: parent.height; text: ["Enlace e IP","Perfiles WLAN","Redes visibles"][i]; color: root.muted; font-size: root.small; }
            }
        }
    }
    Rectangle { x: root.pad; y: root.height - 46px; width: root.width - 2 * root.pad; height: 1px; background: root.ink; }
    Data { x: root.pad; y: root.height - 43px; width: root.width - 2 * root.pad; height: 19px;
        text: "← → Lámina · 1–9 Acceso · PgUp/PgDn ±5 · Inicio/Fin · Esc salir"; color: root.ink; font-size: root.small; }
    Data { x: root.pad; y: root.height - 22px; width: root.width - 2 * root.pad; height: 19px;
        text: "Tab / ↑ ↓ foco  ·  Enter acción  ·  Espacio " + (root.paused ? "reanudar" : "pausa") + "  ·  R reiniciar"; color: root.muted; font-size: root.small; }
}
