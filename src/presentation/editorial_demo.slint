            Data { x: plate.w * 0.67; y: plate.h * 0.79; width: plate.w * 0.33; height: plate.h * 0.16; text: root.paused ? "PAUSA" : "SECUENCIA ACTIVA"; horizontal-alignment: right; color: root.muted; font-size: root.small; }
