            Data { x: plate.w * 0.51; y: plate.h * 0.50; width: plate.w * 0.49; height: plate.h * 0.19; text: root.action ? ["Firma: válida (demo)","TLS: contenido no observado","Sin cambio en esta muestra"][root.selected] : "Enter para expandir"; color: root.muted; font-size: root.small; }
        }
