            Head { x: 12px; y: plate.h * 0.12; width: plate.w - 24px; height: plate.h * 0.22; text: "Ruta de diagnóstico"; color: root.paper; font-size: min(plate.w * 0.078,plate.h * 0.22); }
            Rectangle { x: plate.w * 0.04; y: plate.h * 0.37; width: plate.w * 0.92; height: plate.h * 0.35; background: transparent;
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 12.5 50 C 18 50 22 14 25 14 S 32 50 37.5 50 C 43 50 47 14 50 14 S 57 50 62.5 50 M 12.5 50 C 18 50 22 86 25 86 S 32 50 37.5 50 C 43 50 47 86 50 86 S 57 50 62.5 50 M 12.5 50 L 62.5 50"; fill: transparent; stroke: root.mint; stroke-width: 1.4px; }
