                Path { x: parent.width * 0.37799999999999995; y: parent.height * 0.15; width: parent.width * 0.065; height: parent.height * 0.74; viewbox-width: 10; viewbox-height: 100; fit: fill; commands: "M 0 90 L 0 20 L 5 0 L 10 20 L 10 90 L 5 100 Z"; fill: root.phase == 4 ? root.acid : root.moss; stroke: root.moss; stroke-width: 1px; }
                Path { x: parent.width * 0.46; y: parent.height * 0.15; width: parent.width * 0.065; height: parent.height * 0.74; viewbox-width: 10; viewbox-height: 100; fit: fill; commands: "M 0 90 L 0 20 L 5 0 L 10 20 L 10 90 L 5 100 Z"; fill: root.phase == 5 ? root.acid : root.moss; stroke: root.moss; stroke-width: 1px; }
