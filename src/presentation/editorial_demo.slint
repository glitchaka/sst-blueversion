            Head { x: plate.w * 0.66; y: plate.h * 0.23; width: plate.w * 0.31; height: plate.h * 0.20; text: root.cpu >= 85 ? "ALERTA" : "NORMAL"; color: root.cpu >= 85 ? root.amber : root.acid; font-size: min(plate.w * 0.055,plate.h * 0.16); }
