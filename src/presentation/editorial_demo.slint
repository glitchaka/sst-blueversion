                Data { visible: plate.w >= 570px; x: parent.width * 0.73; width: parent.width * 0.25; height: parent.height; text: ["Estado","Cargado","Cargado","Cargado","Cargado","Cargado"][i]; color: i == 0 ? root.paper : root.muted; font-size: root.small; }
