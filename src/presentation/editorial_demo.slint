            Head { x: 0; y: plate.h * 0.11; width: plate.w * 0.73; height: plate.h * 0.25; text: "Continuidad"; color: root.ink; font-size: min(plate.w * 0.094,plate.h * 0.25); }
            Head { x: plate.w * 0.73; y: plate.h * 0.08; width: plate.w * 0.27; height: plate.h * 0.26; text: "16.7%"; horizontal-alignment: right; color: root.oxide; font-size: min(plate.w * 0.075,plate.h * 0.22); }
