            Data { x: plate.w * 0.66; y: plate.h * 0.81; width: plate.w * 0.31; height: plate.h * 0.11; text: root.paused ? "MUESTRA CONGELADA" : "MUESTRA EN CURSO"; color: root.paper; font-size: root.small; }
        }
