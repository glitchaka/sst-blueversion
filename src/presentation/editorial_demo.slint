// SST native component catalogue. Each specimen is an isolated graphic at control scale.
// No pictures, report covers, or changes to normal terminal rendering.
export component EditorialDemo inherits Rectangle {
    in property <int> page;
    in property <int> count;
    in property <string> title;
    in property <int> selected;
    in property <int> progress;
    in property <int> cpu;
    in property <int> phase;
    in property <bool> blink;
    in property <bool> paused;
    in property <bool> action;
    in property <string> palette-name;
    in property <color> graphite;
    in property <color> ink;
    in property <color> cream;
    in property <color> muted;
    in property <color> line;
    in property <color> rail;
    in property <color> oxide;
    in property <color> acid;
    in property <color> amber;
    in property <color> mint;
    in property <color> moss;
    in property <color> on-failure;
    in property <color> on-success;
    in property <color> accent-detail;
    property <length> gap: 18px;
    property <length> pad: 16px;
    property <bool> wide: self.width >= 1000px;
    background: root.graphite; clip: true;
    Text { x: root.pad; y: 0px; width: parent.width * 0.62 - root.pad; height: 30px; text:  "ELEMENTOS GRÁFICOS / " + root.title; color: root.cream; font-family: "Cascadia Mono"; font-size: 15px; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width * 0.62; y: 0px; width: parent.width * 0.38 - root.pad; height: 30px; text: root.palette-name + "   " + root.page + "/" + root.count; color: root.muted; font-family: "Cascadia Mono"; font-size: 12px; font-weight: 500; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    Rectangle { x: root.pad; y: 30px; width: parent.width - 2 * root.pad; height: 1px; background: root.line; }
    Rectangle {
        x: root.pad; y: 39px; width: parent.width - 2 * root.pad; height: max(1px, parent.height - 73px); background: transparent;
        if root.page == 1 : Rectangle {
            width: parent.width; height: parent.height; background: transparent;
            // specimen 01 — Cabecera asimétrica
            Rectangle {
                x: root.wide ? (parent.width + root.gap) / 3 * 0 : (parent.width + root.gap) / 2 * 0;
                y: root.wide ? (parent.height + root.gap) / 2 * 0 : (parent.height + root.gap) / 3 * 0;
