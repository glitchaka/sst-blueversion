                Path { visible: root.progress > 0; width: max(1px,parent.width * root.progress / 100); height: parent.height;
                    viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 97 0 L 100 50 L 97 100 L 0 100 Z";
                    fill: root.progress == 100 ? root.moss : root.ink; }
                for i in 9 : Rectangle { x: parent.width * (i+1)/10; y: parent.height - 5px; width: 1px; height: 5px; background: root.paper; }
            }
