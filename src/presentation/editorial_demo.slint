Rectangle { x: 0px; y: 0px; width: parent.width; height: 17px; background: root.selected == 4 && root.action && 0 == 1 ? root.acid : 0 == 0 ? root.rail : transparent; }Text { x: 5px; y: 0px; width: parent.width - 10px; height: 17px; text: "› interfaces"; color: root.cream; font-family: "Cascadia Mono"; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }Rectangle { x: 0px; y: 18px; width: parent.width; height: 17px; background: root.selected == 4 && root.action && 1 == 1 ? root.acid : 1 == 0 ? root.rail : transparent; }Text { x: 5px; y: 18px; width: parent.width - 10px; height: 17px; text: "  profiles"; color: root.selected == 4 && root.action ? root.ink : root.cream; font-family: "Cascadia Mono"; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }Rectangle { x: 0px; y: 36px; width: parent.width; height: 17px; background: root.selected == 4 && root.action && 2 == 1 ? root.acid : 2 == 0 ? root.rail : transparent; }Text { x: 5px; y: 36px; width: parent.width - 10px; height: 17px; text: "  networks"; color: root.cream; font-family: "Cascadia Mono"; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                }
            }
            // specimen 36 — Jerarquía de dato
            Rectangle {
                x: root.wide ? (parent.width + root.gap) / 3 * 2 : (parent.width + root.gap) / 2 * 1;
                y: root.wide ? (parent.height + root.gap) / 2 * 1 : (parent.height + root.gap) / 3 * 2;
                width: root.wide ? (parent.width - 2 * root.gap) / 3 : (parent.width - root.gap) / 2;
                height: root.wide ? (parent.height - root.gap) / 2 : (parent.height - 2 * root.gap) / 3;
                background: transparent; clip: true;
                Text { x: 0px; y: 0px; width: parent.width; height: 20px; text: "36 / Jerarquía de dato"; color: root.selected == 5 ? root.acid : root.muted; font-family: "Cascadia Mono"; font-size: 12px; font-weight: 600; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                Rectangle { x: 0px; y: 21px; width: parent.width; height: 1px; background: root.selected == 5 ? root.acid : root.line; }
                Rectangle { x: 2px; y: 27px; width: parent.width - 4px; height: max(1px, min(82px, parent.height - 29px)); background: transparent; clip: true;
Text { x: 0px; y: 0px; width: parent.width * 0.35; height: 19px; text: "PID"; color: root.muted; font-family: "Cascadia Mono"; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }Text { x: 0px; y: 19px; width: parent.width * 0.45; height: 28px; text: "4321"; color: root.cream; font-family: "Cascadia Mono"; font-size: 19px; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }Rectangle { x: parent.width * 0.49; y: 2px; width: 1px; height: 42px; background: root.line; }Text { x: parent.width * 0.54; y: 0px; width: parent.width * 0.46; height: 19px; text: "ESTADO"; color: root.muted; font-family: "Cascadia Mono"; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }Text { x: parent.width * 0.54; y: 19px; width: parent.width * 0.46; height: 28px; text: "ACTIVO"; color: root.mint; font-family: "Cascadia Mono"; font-size: 13px; font-weight: 700; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
    Rectangle { x: root.pad; y: parent.height - 28px; width: parent.width - 2 * root.pad; height: 1px; background: root.line; }
    Text { x: root.pad; y: parent.height - 26px; width: parent.width - 2 * root.pad; height: 24px; text: "← → familia · 1–6 acceso · Tab foco · Enter prueba · Espacio " + (root.paused ? "reanudar" : "pausa") + " · R reiniciar · Esc salir"; color: root.muted; font-family: "Cascadia Mono"; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
}
