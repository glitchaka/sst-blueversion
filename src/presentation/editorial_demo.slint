                Data { width: parent.width; height: parent.height * 0.53; text: name; horizontal-alignment: center; font-size: root.normal; color: root.paper; }
                Data { y: parent.height * 0.55; width: parent.width; height: parent.height * 0.45; text: ["OK","1 ms","FALLO","No probado"][i]; horizontal-alignment: center; font-size: root.small; color: i == 2 ? root.amber : root.mint; }
            }
            Data { x: 12px; y: plate.h * 0.90; width: plate.w - 24px; height: plate.h * 0.10; text: "Siguiente: comprobar DNS antes de inferir caída del destino."; color: root.paper; font-size: root.small; }
        }
        // 18 — partial evidence: absence of telemetry is not a failure.
        if root.page == 18 : Rectangle {
            Rectangle { x: 0; y: 0; width: 5px; height: plate.h * 0.82; background: root.muted; }
            Data { x: 14px; width: plate.w - 14px; height: plate.h * 0.13; text: "COBERTURA PARCIAL / ETW"; color: root.muted; font-size: root.small; }
            Head { x: 14px; y: plate.h * 0.13; width: plate.w - 14px; height: plate.h * 0.32; text: "Dato no disponible"; color: root.ink; font-size: min(plate.w * 0.080,plate.h * 0.30); }
            Label { x: 14px; y: plate.h * 0.48; width: plate.w - 14px; height: plate.h * 0.14; text: "No se pudo iniciar la sesión de telemetría."; color: root.ink; font-size: root.normal; }
            Data { x: 14px; y: plate.h * 0.66; width: plate.w - 14px; height: plate.h * 0.11; text: "Disponible: conexiones y PID / No medido: bytes por proceso"; color: root.muted; font-size: root.small; }
            Data { x: 14px; y: plate.h * 0.86; width: plate.w - 14px; height: plate.h * 0.11; text: "No equivale a 0 B/s ni demuestra ausencia de tráfico."; color: root.ink; font-size: root.small; }
        }
        // 19 — indeterminate progress, not a fictitious percentage.
        if root.page == 19 : Rectangle {
            background: root.graphite;
            Path { x: plate.w * 0.64; y: plate.h * 0.05; width: plate.w * 0.34; height: plate.h * 0.76; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 20 L 20 0 L 100 0 L 100 80 L 80 100 L 0 100 Z"; fill: transparent; stroke: root.steel; stroke-width: 1px; }
            Data { x: 12px; y: 0; width: plate.w * 0.60; height: plate.h * 0.12; text: "OPERACIÓN / INVENTARIO"; color: root.mint; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.16; width: plate.w * 0.60; height: plate.h * 0.28; text: root.action ? "RECIBIDO" : "CONSULTA"; color: root.paper; font-size: min(plate.w * 0.095,plate.h * 0.29); }
            Label { x: 12px; y: plate.h * 0.48; width: plate.w * 0.60; height: plate.h * 0.12; text: root.action ? "Resultado disponible" : "Total aún desconocido"; color: root.mint; font-size: root.normal; }
            Rectangle { x: plate.w * 0.66; y: plate.h * 0.12; width: plate.w * 0.30; height: plate.h * 0.58; background: transparent;
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 6 0 L 16 100 M 14 0 L 24 100 M 22 0 L 32 100 M 30 0 L 40 100 M 38 0 L 48 100 M 46 0 L 56 100 M 54 0 L 64 100 M 62 0 L 72 100 M 70 0 L 80 100 M 78 0 L 88 100 M 86 0 L 96 100 M 94 0 L 104 100"; fill: transparent; stroke: root.steel; stroke-width: 1.5px; }
                for i in 12 : Rectangle { x: i * parent.width / 12; width: parent.width / 12; height: parent.height; background: transparent;
                    Path { width: parent.width; height: parent.height; viewbox-width: 10; viewbox-height: 100; fit: fill; commands: "M 0 10 L 10 0 L 10 90 L 0 100 Z"; fill: root.action ? root.moss : i == root.phase ? root.acid : transparent; } }
            }
            Path { x: 12px; y: plate.h * 0.72; width: plate.w * 0.57; height: plate.h * 0.06; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 95 0 L 100 100 L 0 100 Z"; fill: root.steel; stroke: transparent; stroke-width: 0px; }
            Data { x: 12px; y: plate.h * 0.83; width: plate.w - 24px; height: plate.h * 0.13; text: root.action ? "COMPLETO / ENTER REINICIA" : "SIN PORCENTAJE FICTICIO / ENTER SIMULA RESPUESTA"; color: root.paper; font-size: root.small; }
        }
        // 20 — suggestions anchored to a command, with live keyboard selection.
        if root.page == 20 : Rectangle {
            Head { x: 0; width: plate.w; height: plate.h * 0.22; text: "Sugerencias contextuales"; color: root.ink; font-size: min(plate.w * 0.070,plate.h * 0.21); }
            Rectangle { y: plate.h * 0.25; width: plate.w; height: plate.h * 0.17; background: root.ink;
                Data { x: 8px; width: parent.width - 16px; height: parent.height; text: root.action ? "> notsh wlan show " + ["interfaces","profiles","networks"][root.selected] : "> notsh wlan show"; color: root.paper; font-size: root.normal; }
            }
            for name[i] in ["interfaces","profiles","help"] : Rectangle {
                x: plate.w * 0.17; y: plate.h * (0.46 + i * 0.15); width: plate.w * 0.83; height: plate.h * 0.14; background: root.selected == i ? rgb(210, 215, 200) : transparent;
                Rectangle { x: 0; width: 3px; height: parent.height; background: root.selected == i ? root.moss : root.rule; }
                Data { x: 8px; width: parent.width * 0.37; height: parent.height; text: name; color: root.ink; font-size: root.normal; }
                Label { x: parent.width * 0.40; width: parent.width * 0.58; height: parent.height; text: ["Enlace e IP","Perfiles WLAN","Redes visibles"][i]; color: root.muted; font-size: root.small; }
            }
        }
    }
    Rectangle { x: root.pad; y: root.height - 46px; width: root.width - 2 * root.pad; height: 1px; background: root.ink; }
    Data { x: root.pad; y: root.height - 43px; width: root.width - 2 * root.pad; height: 19px;
        text: "← → Lámina · 1–9 Acceso · PgUp/PgDn ±5 · Inicio/Fin · Esc salir"; color: root.ink; font-size: root.small; }
    Data { x: root.pad; y: root.height - 22px; width: root.width - 2 * root.pad; height: 19px;
        text: "Tab / ↑ ↓ foco  ·  Enter acción  ·  Espacio " + (root.paused ? "reanudar" : "pausa") + "  ·  R reiniciar"; color: root.muted; font-size: root.small; }
}
