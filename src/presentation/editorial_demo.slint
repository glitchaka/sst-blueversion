// Native editorial specimens. No Image, SVG assets, screenshots or terminal skins.
// The graphics carry information: alignment, magnitude, state, sequence, focus.
component Head inherits Text {
    font-family: "Segoe UI Variable Display";
    font-weight: 800;
    vertical-alignment: center;
    overflow: elide;
}
component Label inherits Text {
    font-family: "Segoe UI Variable";
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}
component Data inherits Text {
    font-family: "Cascadia Mono";
    vertical-alignment: center;
    overflow: elide;
}
export component EditorialDemo inherits Rectangle {
    in property <int> page;
    in property <int> count;
    in property <string> title;
    in property <int> selected;
    in property <int> progress;
    in property <int> cpu;
    in property <int> phase;
    in property <bool> blink;
    in property <bool> paused;
    in property <bool> action;

    property <color> paper: rgb(235, 231, 219);
    property <color> ink: rgb(24, 25, 23);
    property <color> muted: rgb(102, 107, 100);
    property <color> rule: rgb(165, 165, 154);
    property <color> acid: rgb(217, 232, 45);
    property <color> steel: rgb(73, 86, 82);
    property <color> white-ink: rgb(233, 229, 215);
    property <color> graphite: rgb(25, 30, 29);
    property <color> oxide: rgb(176, 53, 38);
    property <color> alert: rgb(168, 46, 36);
    property <color> amber: rgb(239, 181, 103);
    property <color> mint: rgb(167, 189, 166);
    property <color> moss: rgb(38, 91, 76);
    property <length> pad: min(32px, max(10px, self.width * 0.035));
    property <length> small: min(14px, max(10px,self.height * 0.033));
    property <length> normal: min(19px, max(12px,self.height * 0.045));
    background: root.paper;
    clip: true;

    Rectangle { x: 0; y: 0; width: parent.width; height: 30px; background: root.paper;
        Rectangle { x: root.pad; y: 29px; width: parent.width - 2 * root.pad; height: 1px; background: root.ink; }
        Data { x: root.pad; width: parent.width * 0.69; height: parent.height; text: "SST   /   SISTEMAS     —     " + root.title; color: root.ink; font-size: root.small; }
        Data { x: parent.width * 0.70; width: parent.width * 0.30 - root.pad; height: parent.height; horizontal-alignment: right;
            text: "PRUEBA   " + root.page + " / " + root.count; color: root.muted; font-size: root.small; }
    }
    plate := Rectangle {
        x: root.pad; y: 36px; width: root.width - 2 * root.pad; height: max(1px,root.height - 87px);
        background: root.paper; clip: true;
        property <length> w: self.width;
        property <length> h: self.height;

        // 01 — a typographic cover with asymmetric columns; the datum is the image.
        if root.page == 1 : Rectangle {
            // Editorial architecture: the cutout is the section index, not wallpaper.
            Path { x: plate.w * 0.67; y: plate.h * 0.035; width: plate.w * 0.33; height: plate.h * 0.94; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 100 0 L 100 70 L 77 70 L 77 100 L 0 100 L 0 79 L 58 79 L 58 23 L 0 23 Z"; fill: root.ink; stroke: transparent; stroke-width: 0px; }
            Path { x: plate.w * 0.70; y: plate.h * 0.07; width: plate.w * 0.27; height: plate.h * 0.86; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 100 0 L 100 70 L 70 70 L 70 100 M 6 8 L 92 8 L 92 63 L 62 63 L 62 92"; fill: transparent; stroke: root.rule; stroke-width: 1px; }
            Data { x: 0; y: plate.h * 0.02; width: plate.w * 0.65; height: plate.h * 0.10; text: "SST / SISTEMAS LOCALES     VOL. 01"; color: root.muted; font-size: root.small; }
            Head { x: 0; y: plate.h * 0.12; width: plate.w * 0.68; height: plate.h * 0.34; text: "ESTADO"; color: root.ink; font-size: min(plate.w * 0.143,plate.h * 0.34); }
            Head { x: 0; y: plate.h * 0.44; width: plate.w * 0.67; height: plate.h * 0.24; text: "DEL EQUIPO"; color: root.ink; font-size: min(plate.w * 0.077,plate.h * 0.24); }
            Path { x: 0; y: plate.h * 0.71; width: plate.w * 0.64; height: plate.h * 0.025; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 88 0 L 100 100 L 0 100 Z"; fill: root.oxide; stroke: transparent; stroke-width: 0px; }
            Data { x: 0; y: plate.h * 0.76; width: plate.w * 0.66; height: plate.h * 0.11; text: "Windows 11 / 16 GiB / x86-64"; color: root.ink; font-size: root.normal; }
            Data { x: 0; y: plate.h * 0.88; width: plate.w * 0.66; height: plate.h * 0.10; text: "INVENTARIO LOCAL · MUESTRA DE COMPOSICIÓN"; color: root.muted; font-size: root.small; }
            Head { x: plate.w * 0.685; y: plate.h * 0.28; width: plate.w * 0.175; height: plate.h * 0.30; text: "08"; color: root.oxide; font-size: min(plate.w * 0.115,plate.h * 0.31); }
            Data { x: plate.w * 0.685; y: plate.h * 0.59; width: plate.w * 0.18; height: plate.h * 0.12; text: "RECURSOS"; color: root.ink; font-size: root.small; }
            Data { x: plate.w * 0.72; y: plate.h * 0.82; width: plate.w * 0.19; height: plate.h * 0.11; text: "SYS / 01"; color: root.paper; font-size: root.small; }
        }
        // 02 — index-led network section, not a card.
        if root.page == 2 : Rectangle {
            background: root.graphite;
            Path { x: 0; y: 0; width: plate.w * 0.27; height: plate.h; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 100 0 L 100 20 L 78 20 L 78 82 L 100 82 L 100 100 L 0 100 L 0 82 L 24 82 L 24 20 L 0 20 Z"; fill: root.steel; stroke: transparent; stroke-width: 0px; }
            Path { x: plate.w * 0.023; y: plate.h * 0.045; width: plate.w * 0.215; height: plate.h * 0.91; viewbox-width: 100; viewbox-height: 100; fit: fill; commands: "M 0 0 L 100 0 L 100 14 L 75 14 L 75 86 L 100 86 L 100 100 L 0 100 M 12 0 L 12 100"; fill: transparent; stroke: root.mint; stroke-width: 1px; }
            Head { x: plate.w * 0.035; y: plate.h * 0.29; width: plate.w * 0.20; height: plate.h * 0.28; text: "02"; color: root.paper; font-size: min(plate.w * 0.128,plate.h * 0.29); }
            Data { x: plate.w * 0.035; y: plate.h * 0.61; width: plate.w * 0.20; height: plate.h * 0.11; text: "NODOS"; color: root.mint; font-size: root.small; }
            Data { x: plate.w * 0.30; y: plate.h * 0.03; width: plate.w * 0.66; height: plate.h * 0.10; text: "NET / INTERFACES / 01 ACTIVA"; color: root.mint; font-size: root.small; }
            Head { x: plate.w * 0.30; y: plate.h * 0.12; width: plate.w * 0.67; height: plate.h * 0.25; text: "RED LOCAL"; color: root.paper; font-size: min(plate.w * 0.087,plate.h * 0.25); }
            for item[i] in ["Ethernet","Wi-Fi"] : Rectangle {
                x: plate.w * 0.30; y: plate.h * (0.42 + i * 0.235); width: plate.w * 0.67; height: plate.h * 0.22;
                Path { width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100; fit: fill;
                    commands: "M 0 0 L 93 0 L 100 34 M 100 100 L 7 100 L 0 66"; stroke: root.steel; stroke-width: 1px; }
                Label { x: 8px; width: parent.width * 0.56; height: parent.height; text: item; color: root.paper; font-size: root.normal; }
                Data { x: parent.width * 0.57; width: parent.width * 0.40; height: parent.height; horizontal-alignment: right; text: i == 0 ? "ACTIVO" : "INACTIVO"; color: i == 0 ? root.acid : root.mint; font-size: root.small; }
            }
            Data { x: plate.w * 0.30; y: plate.h * 0.90; width: plate.w * 0.67; height: plate.h * 0.09; text: "Estado físico e IP / no certifica NAC"; color: root.mint; font-size: root.small; }
        }
        // 03 — memory as an area-proportional horizontal cut.
        if root.page == 3 : Rectangle {
            background: root.graphite;
            Data { x: 12px; y: 0; width: plate.w - 24px; height: plate.h * 0.15; text: "MEMORIA FÍSICA / 16 GiB"; color: root.mint; font-size: root.small; }
            Rectangle { x: 12px; y: plate.h * 0.19; width: plate.w - 24px; height: plate.h * 0.58; background: rgb(127, 140, 131);
                Rectangle { width: parent.width * 0.65; height: parent.height; background: root.paper;
                    Head { x: 8px; width: parent.width - 16px; height: parent.height * 0.75; text: "65%"; color: root.ink; font-size: min(parent.width * 0.43,parent.height * 0.70); }
                    Data { x: 12px; y: parent.height * 0.78; width: parent.width - 24px; height: parent.height * 0.20; text: "10.4 GiB usados"; font-size: root.small; color: root.ink; }
                }
                Data { x: parent.width * 0.68; width: parent.width * 0.30; height: parent.height; text: "5.6 GiB libres"; color: root.ink; font-size: root.small; }
            }
            Data { x: 12px; y: plate.h * 0.82; width: plate.w - 24px; height: plate.h * 0.14; text: "Capacidad y proporción, no velocidad de memoria."; color: root.white-ink; font-size: root.small; }
        }
        // 04 — native aligned service register with sparse rules.
        if root.page == 4 : Rectangle {
            Head { x: 0; y: 0; width: plate.w * 0.76; height: plate.h * 0.30; text: "Servicios"; color: root.ink; font-size: min(plate.w * 0.13,plate.h * 0.30); }
            Data { x: plate.w * 0.76; width: plate.w * 0.24; height: plate.h * 0.30; horizontal-alignment: right; text: "03 / REGISTROS"; font-size: root.small; color: root.muted; }
            for name[i] in ["Servicio","W32Time","Spooler","BITS"] : Rectangle {
                y: plate.h * (0.34 + i * 0.16); width: plate.w; height: plate.h * 0.16; background: i == 0 ? root.ink : transparent;
                Rectangle { y: 0; width: parent.width; height: 1px; background: root.rule; }
                Data { x: 8px; width: parent.width * 0.46; height: parent.height; text: name; font-size: root.normal; color: i == 0 ? root.paper : root.ink; }
                Data { x: parent.width * 0.49; width: parent.width * 0.30; height: parent.height; text: ["Estado","Activo","Activo","Detenido"][i]; font-size: root.normal; color: i == 0 ? root.paper : i == 3 ? root.muted : root.moss; }
                Data { x: parent.width * 0.83; width: parent.width * 0.15; height: parent.height; horizontal-alignment: right; text: ["PID","804","1220","—"][i]; color: i == 0 ? root.paper : root.ink; font-size: root.small; }
            }
        }
        // 05 — keyboard focus, distinct from activation.
        if root.page == 5 : Rectangle {
            background: root.graphite;
            Head { x: 12px; y: 0; width: plate.w - 24px; height: plate.h * 0.22; text: "Diagnóstico dirigido"; color: root.paper; font-size: min(plate.w * 0.070,plate.h * 0.22); }
            for item[i] in ["Procesos","Servicios","Conexiones"] : Rectangle {
                x: 12px; y: plate.h * (0.27 + i * 0.19); width: plate.w * 0.58 - 16px; height: plate.h * 0.17;
                background: transparent;
                Path { width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100; fit: fill;
                    commands: "M 0 0 L 92 0 L 100 40 L 100 100 L 0 100 Z"; fill: i == root.selected ? root.paper : transparent; stroke: root.steel; stroke-width: 1px; }
                Path { x: 0; width: 7px; height: parent.height; viewbox-width: 10; viewbox-height: 100; fit: fill;
                    commands: "M 0 0 L 10 15 L 10 85 L 0 100 Z"; fill: i == root.selected ? root.acid : root.steel; }
                Data { x: 12px; width: parent.width - 24px; height: parent.height; text: "0" + (i+1) + "  " + item; font-size: root.normal; color: i == root.selected ? root.ink : root.paper; }
            }
            Rectangle { x: plate.w * 0.60; y: plate.h * 0.28; width: 1px; height: plate.h * 0.52; background: root.mint; }
            Head { x: plate.w * 0.63; y: plate.h * 0.29; width: plate.w * 0.34; height: plate.h * 0.21; text: "0" + (root.selected+1); font-size: min(plate.w * 0.12,plate.h * 0.22); color: root.amber; }
            Label { x: plate.w * 0.63; y: plate.h * 0.54; width: plate.w * 0.34; height: plate.h * 0.14; text: root.action ? "Activado (demo)" : "Solo foco"; color: root.paper; font-size: root.normal; }
            Data { x: 12px; y: plate.h * 0.88; width: plate.w - 24px; height: plate.h * 0.10; text: "Tab / ↑ ↓: foco     Enter: activar o volver"; font-size: root.small; color: root.mint; }
        }
        // 06 — threshold delta and a scale with the reference line.
        if root.page == 6 : Rectangle {
            background: rgb(232, 200, 163);
            Data { x: 12px; y: 0; width: plate.w - 24px; height: plate.h * 0.15; text: "ATENCIÓN / PRESIÓN DE MEMORIA"; color: root.ink; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.14; width: plate.w * 0.56; height: plate.h * 0.43; text: "89%"; color: root.ink; font-size: min(plate.w * 0.21,plate.h * 0.43); }
            Head { x: plate.w * 0.63; y: plate.h * 0.18; width: plate.w * 0.34; height: plate.h * 0.30; text: "+4"; color: root.oxide; font-size: min(plate.w * 0.13,plate.h * 0.29); }
            Data { x: plate.w * 0.63; y: plate.h * 0.48; width: plate.w * 0.34; height: plate.h * 0.09; text: "puntos sobre umbral"; color: root.ink; font-size: root.small; }
            Rectangle { x: 12px; y: plate.h * 0.65; width: plate.w - 24px; height: plate.h * 0.10; background: rgb(183, 163, 142);
                Rectangle { width: parent.width * 0.89; height: parent.height; background: root.ink; }
                Rectangle { x: parent.width * 0.85; y: -5px; width: 3px; height: parent.height + 10px; background: root.oxide; }
            }
            Data { x: 12px; y: plate.h * 0.80; width: plate.w * 0.6; height: plate.h * 0.14; text: "ACCIÓN: revisar procesos"; color: root.ink; font-size: root.small; }
            Data { x: plate.w * 0.63; y: plate.h * 0.80; width: plate.w * 0.34; height: plate.h * 0.14; text: "UMBRAL 85%"; horizontal-alignment: right; color: root.oxide; font-size: root.small; }
        }
        // 07 — recovery bulletin, explicit evidence and next action.
        if root.page == 7 : Rectangle {
            background: root.oxide;
            Data { x: 12px; width: plate.w - 24px; height: plate.h * 0.13; text: "INCIDENCIA 01 / VENTANA"; color: root.paper; font-size: root.small; }
            Head { x: 12px; y: plate.h * 0.13; width: plate.w - 24px; height: plate.h * 0.32; text: "SIN RESPUESTA"; color: root.paper; font-size: min(plate.w * 0.104,plate.h * 0.30); }
            Label { x: 12px; y: plate.h * 0.48; width: plate.w - 24px; height: plate.h * 0.13; text: "Evidencia: la ventana no responde a la consulta."; color: root.paper; font-size: root.normal; }
            Rectangle { y: plate.h * 0.67; width: plate.w; height: plate.h * 0.33; background: root.ink;
                Data { x: 12px; y: 0; width: parent.width - 24px; height: parent.height * 0.48; text: "01  Solicitar cierre normal"; font-size: root.normal; color: root.paper; }
                Data { x: 12px; y: parent.height * 0.48; width: parent.width - 24px; height: parent.height * 0.48; text: "02  Verificar instancia"; font-size: root.small; color: root.mint; }
            }
        }
        // 08 — twenty calibrated divisions; dynamic reading.
        if root.page == 8 : Rectangle {
            background: root.graphite;
            dial := Rectangle { x: 0; y: 0; width: plate.w * 0.62; height: plate.h; background: transparent;
                property <length> diameter: min(self.width,self.height);
                Rectangle { x: (dial.width-dial.diameter)/2; y: (dial.height-dial.diameter)/2; width: dial.diameter; height: dial.diameter; background: transparent;
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 14 100 A 86 86 0 1 1 186 100 A 86 86 0 1 1 14 100"; fill: transparent; stroke: root.steel; stroke-width: 1px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 34.54 163.214 A 91 91 0 0 1 23.251 148.894 L 33.372 142.447 A 79 79 0 0 0 43.172 154.878 Z"; fill: root.cpu >= 5 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 21.592 146.186 A 91 91 0 0 1 13.958 129.627 L 25.304 125.72 A 79 79 0 0 0 31.931 140.096 Z"; fill: root.cpu >= 10 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 12.976 126.606 A 91 91 0 0 1 9.419 108.722 L 21.364 107.572 A 79 79 0 0 0 24.452 123.097 Z"; fill: root.cpu >= 15 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 9.17 105.555 A 91 91 0 0 1 9.886 87.335 L 21.769 89.005 A 79 79 0 0 0 21.147 104.823 Z"; fill: root.cpu >= 20 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 10.382 84.198 A 91 91 0 0 1 15.332 66.648 L 26.497 71.046 A 79 79 0 0 0 22.2 86.282 Z"; fill: root.cpu >= 25 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 16.548 63.714 A 91 91 0 0 1 25.457 47.805 L 35.287 54.687 A 79 79 0 0 0 27.552 68.499 Z"; fill: root.cpu >= 30 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 27.324 45.235 A 91 91 0 0 1 39.702 31.845 L 47.653 40.832 A 79 79 0 0 0 36.908 52.457 Z"; fill: root.cpu >= 35 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 42.117 29.782 A 91 91 0 0 1 57.278 19.652 L 62.912 30.247 A 79 79 0 0 0 49.75 39.042 Z"; fill: root.cpu >= 40 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 60.108 18.21 A 91 91 0 0 1 77.215 11.899 L 80.22 23.516 A 79 79 0 0 0 65.369 28.995 Z"; fill: root.cpu >= 45 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 80.304 11.157 A 91 91 0 0 1 98.412 9.014 L 98.621 21.012 A 79 79 0 0 0 82.901 22.873 Z"; fill: root.cpu >= 50 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 101.588 9.014 A 91 91 0 0 1 119.696 11.157 L 117.099 22.873 A 79 79 0 0 0 101.379 21.012 Z"; fill: root.cpu >= 55 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 122.785 11.899 A 91 91 0 0 1 139.892 18.21 L 134.631 28.995 A 79 79 0 0 0 119.78 23.516 Z"; fill: root.cpu >= 60 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 142.722 19.652 A 91 91 0 0 1 157.883 29.782 L 150.25 39.042 A 79 79 0 0 0 137.088 30.247 Z"; fill: root.cpu >= 65 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 160.298 31.845 A 91 91 0 0 1 172.676 45.235 L 163.092 52.457 A 79 79 0 0 0 152.347 40.832 Z"; fill: root.cpu >= 70 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 174.543 47.805 A 91 91 0 0 1 183.452 63.714 L 172.448 68.499 A 79 79 0 0 0 164.713 54.687 Z"; fill: root.cpu >= 75 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 184.668 66.648 A 91 91 0 0 1 189.618 84.198 L 177.8 86.282 A 79 79 0 0 0 173.503 71.046 Z"; fill: root.cpu >= 80 ? (root.acid) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 190.114 87.335 A 91 91 0 0 1 190.83 105.555 L 178.853 104.823 A 79 79 0 0 0 178.231 89.005 Z"; fill: root.cpu >= 85 ? (root.oxide) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 190.581 108.722 A 91 91 0 0 1 187.024 126.606 L 175.548 123.097 A 79 79 0 0 0 178.636 107.572 Z"; fill: root.cpu >= 90 ? (root.oxide) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 186.042 129.627 A 91 91 0 0 1 178.408 146.186 L 168.069 140.096 A 79 79 0 0 0 174.696 125.72 Z"; fill: root.cpu >= 95 ? (root.oxide) : root.steel; stroke: transparent; stroke-width: 0px; }
                Path { x: 0; y: 0; width: parent.width; height: parent.height; viewbox-width: 200; viewbox-height: 200; fit: fill; commands: "M 176.749 148.894 A 91 91 0 0 1 165.46 163.214 L 156.828 154.878 A 79 79 0 0 0 166.628 142.447 Z"; fill: root.cpu >= 100 ? (root.oxide) : root.steel; stroke: transparent; stroke-width: 0px; }
